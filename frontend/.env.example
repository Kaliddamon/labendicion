# Google OAuth2 - Obtén en https://console.cloud.google.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Opcional. En local no hace falta: el frontend usa /api/frontend y Vite lo proxifica a http://127.0.0.1:8080.
# En producción (sistema híbrido), configura las siguientes URLs:
VITE_API_URL_AZURE=https://labendicionweb.azurewebsites.net
VITE_API_URL_RENDER=https://labendicion-backend.onrender.com
