<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.4</version>
        <relativePath/>
    </parent>
    <groupId>dev.kali</groupId>
    <artifactId>labendicion</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>labendicion</name>
    <description>Sistema de gestión para microempresa textil</description>
    <properties>
        <java.version>17</java.version>
    </properties>
    <dependencies>
        <!-- Web & REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Health (/actuator/health) para Docker y plataformas -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Data & JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Development & Tools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Database: H2 (Development) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Database: PostgreSQL (Production) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.44</version>
            <scope>provided</scope>
        </dependency>
        <!-- SpringDoc OpenAPI (Swagger UI) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.1.0</version>
        </dependency>

        <!-- Google OAuth2 -->
        <dependency>
            <groupId>com.google.auth</groupId>
            <artifactId>google-auth-library-oauth2-http</artifactId>
            <version>1.11.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.api-client</groupId>
            <artifactId>google-api-client</artifactId>
            <version>1.35.2</version>
        </dependency>
        <dependency>
            <groupId>com.google.http-client</groupId>
            <artifactId>google-http-client-jackson2</artifactId>
            <version>1.43.3</version>
        </dependency>

        <!-- Spring Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Resend API se consume via java.net.http.HttpClient (Java 17+) -->

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <phase>clean</phase>
                        <configuration>
                            <target>
                                <delete file="src/main/java/dev/kali/labendicion/controller/AreaTrabajoController.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/controller/AseoController.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/controller/DashboardController.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/controller/EmpleadoController.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/controller/EmpresaClienteController.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/controller/EvaluacionController.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/controller/FacturacionController.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/controller/MaquinaController.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/controller/MateriaPrimaController.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/controller/OrdenProduccionController.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/controller/PedidoServicioController.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/controller/ReportesController.java"/>
                                
                                <delete file="src/main/java/dev/kali/labendicion/service/AreaTrabajoService.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/service/AseoService.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/service/EmpleadoService.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/service/EmpresaClienteService.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/service/EvaluacionEmpleadoService.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/service/FacturacionService.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/service/MaquinaService.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/service/OrdenProduccionService.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/service/PedidoServicioService.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/service/ReportesService.java"/>
                                
                                <delete file="src/main/java/dev/kali/labendicion/domain/entity/AreaTrabajo.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/domain/entity/AsignacionAseo.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/domain/entity/DetallePedido.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/domain/entity/Empleado.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/domain/entity/EmpresaCliente.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/domain/entity/Entrega.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/domain/entity/EntregadoPorEmpleado.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/domain/entity/EvaluacionEmpleado.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/domain/entity/Factura.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/domain/entity/MantenimientoMaquina.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/domain/entity/Maquina.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/domain/entity/MateriaPrimaRecibida.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/domain/entity/OrdenProduccion.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/domain/entity/Pago.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/domain/entity/PedidoServicio.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/domain/entity/TareaAseo.java"/>
                                
                                <delete file="src/main/java/dev/kali/labendicion/repository/AreaTrabajoRepository.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/repository/AsignacionAseoRepository.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/repository/DetallePedidoRepository.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/repository/EmpleadoRepository.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/repository/EmpresaClienteRepository.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/repository/EntregaRepository.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/repository/EntregadoPorEmpleadoRepository.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/repository/EvaluacionEmpleadoRepository.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/repository/FacturaRepository.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/repository/MantenimientoMaquinaRepository.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/repository/MaquinaRepository.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/repository/MateriaPrimaRecibidaRepository.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/repository/OrdenProduccionRepository.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/repository/PagoRepository.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/repository/PedidoServicioRepository.java"/>
                                <delete file="src/main/java/dev/kali/labendicion/repository/TareaAseoRepository.java"/>
                                
                                <delete dir="src/main/java/dev/kali/labendicion/domain/dto"/>
                                <delete dir="src/main/java/dev/kali/labendicion/domain/enums"/>
                                
                                <delete file="src/main/java/dev/kali/labendicion/config/CorsConfig.java"/>
                                
                                <delete file="API_DOCUMENTATION.md"/>
                                <delete file="CHEAT_SHEET.md"/>
                                <delete file="DEPLOY_RAILWAY.md"/>
                                <delete file="PROJECT_SUMMARY.md"/>
                                <delete file="QUICK_START.md"/>
                                <delete file="SWAGGER_ACCESS.md"/>
                                <delete file="SWAGGER_GUIDE.md"/>

                                <delete dir="../frontend/labendicion"/>
                                <delete dir="../frontend/src/utils"/>
                                <delete dir="../frontend/src/app/utils"/>
                                <delete dir="../frontend/guidelines"/>
                                <delete file="../frontend/ATTRIBUTIONS.md"/>

                                <delete file="../DEPLOYMENT_CHECKLIST.md"/>
                                <delete file="../INDICES_GUIA_EJECUCION.md"/>
                                <delete file="../MIGRACION_PASOS_RELACIONAL.md"/>
                                <delete file="../OPTIMIZACION_PERFORMANCE_GUIA.md"/>
                                <delete file="../QUICK_START_PASOS.md"/>
                                <delete file="../RESUMEN_IMPLEMENTACION.md"/>
                                <delete file="../RESUMEN_OPTIMIZACION.md"/>
                                <delete file="../SOLUTION_SUMMARY.md"/>
                                <delete file="../test-performance.ps1"/>
                                <delete file="../package-lock.json"/>
                                <delete file="../delete.js"/>
                                <delete file="../DeleteFiles.java"/>
                                <delete file="../DeleteFiles.class"/>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.44</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
